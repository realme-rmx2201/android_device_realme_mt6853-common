; Allow rules for denials seen on RMX2201 running the stock MediaTek/OPPO vendor policy.
; Names are the real (unversioned) types: this file is compiled together with the platform cil.
(allow aee_aedv proc_ppm (dir (search)))
(allow bootanim storage_file (lnk_file (read)))
(allow bootanim vendor_file (file (execute getattr map open read)))
(allow ccci_mdinit sysfs_dt_firmware_android (file (getattr open read)))
(allow ccci_rpcd default_prop (file (getattr map open read)))
(allow fsck block_device (blk_file (ioctl open read write)))
(allow fuelgauged_nvram gsi_metadata_file (dir (search)))
(allow fuelgauged_nvram sysfs_dt_firmware_android (dir (search)))
(allow fuelgauged_nvram sysfs_dt_firmware_android (file (getattr open read)))
(allow hal_face_oppo default_android_hwservice (hwservice_manager (find)))
(allow hal_face_oppo system_prop (file (getattr map open read)))
(allow init loop_device (blk_file (ioctl)))
(allow init sysfs_devices_block (file (setattr)))
(allow kernel debugfs_mmc (dir (search)))
(allow kernel tmpfs (chr_file (open)))
(allow mediacodec default_prop (file (getattr map open read)))
(allow mnld default_prop (file (getattr map open read)))
(allow mtk_agpsd system_suspend (binder (call)))
(allow mtk_agpsd system_suspend_hwservice (hwservice_manager (find)))
(allow mtk_hal_audio debugfs_ion (dir (search)))
(allow mtk_hal_audio default_prop (file (getattr map open read)))
(allow mtk_hal_audio gsi_metadata_file (dir (search)))
(allow mtk_hal_audio sysfs_dt_firmware_android (file (getattr open read)))
(allow mtk_hal_audio system_prop (file (getattr map open read)))
(allow mtk_hal_bluetooth gsi_metadata_file (dir (search)))
(allow mtk_hal_camera default_prop (file (getattr map open read)))
(allow mtk_hal_light default_prop (file (getattr map open read)))
(allow mtk_hal_neuralnetworks mtk_nn_option_prop (file (getattr map open read)))
(allow mtk_hal_sensors default_prop (file (getattr map open read)))
(allow netutils_wrapper ccci_device (chr_file (read write)))
(allow netutils_wrapper nvdata_file (file (read)))
(allow netutils_wrapper rild (unix_dgram_socket (read write)))
(allow netutils_wrapper rild (file (read open getattr)))
(allow nvram_daemon gsi_metadata_file (dir (search)))
(allow nvram_daemon proc_cmdline (file (getattr open read)))
(allow nvram_daemon sysfs_dt_firmware_android (dir (search)))
(allow nvram_daemon sysfs_dt_firmware_android (file (getattr open read)))
(allow platform_app vendor_default_prop (file (getattr map open read)))
(allow platform_app vendor_file (file (execute read)))
(allow rild default_prop (file (getattr map open read)))
(allow rild gsi_metadata_file (dir (search)))
(allow rild logmuch_prop (file (getattr map open read)))
(allow self_init default_prop (file (getattr map open read)))
(allow self_init system_file (file (open read)))
(allow self_init system_prop (file (getattr map open read)))
(allow shell ccci_rpcd_exec (file (getattr)))
(allow shell kernel (system (syslog_read)))
(allow shell nvram_daemon_exec (file (getattr)))
(allow shell ppl_agent_exec (file (getattr)))
(allow surfaceflinger storage_file (lnk_file (read)))
(allow surfaceflinger vendor_file (file (execute getattr map open read)))
(allow system_app default_android_hwservice (hwservice_manager (find)))
(allow system_app vendor_file (file (execute read)))
(allow system_server default_android_hwservice (hwservice_manager (find)))
(allow system_suspend mtk_agpsd (binder (transfer)))
(allow ueventd self (capability (sys_nice)))
(allow untrusted_app_27 vendor_file (file (execute read)))
(allow vendor_init debuglog_data_file (dir (ioctl open read setattr)))
(allow vendor_init default_prop (property_service (set)))
(allow vendor_init exported_secure_prop (property_service (set)))
(allow vendor_init fingerprintd_data_file (dir (ioctl open read setattr)))
(allow vendor_init proc_cpufreq (file (write)))
(allow vendor_init proc_swappiness (file (write)))
(allow vendor_init system_data_file (dir (ioctl open read setattr)))
(allow vendor_init system_prop (file (getattr map open read)))
(allow vendor_init system_prop (property_service (set)))
(allow vold_prepare_subdirs self (capability (fsetid)))
(allow zygote storage_file (lnk_file (read)))
(allow zygote vendor_file (file (execute getattr map open read)))
(allow flags_health_check property_type (file (getattr map open read)))
(allow mtk_agpsd system_suspend_server (binder (call)))
(allow system_suspend_server mtk_agpsd (binder (transfer)))
; Lineage HALs shipped in /vendor/bin/hw. The platform policy of this tree does not define their domains.
; The trust HAL needs its own hwservice label (see odm_hwservice_contexts) so it can register.
(type hal_lineage_trust_hwservice)
(typeattributeset hwservice_manager_type (hal_lineage_trust_hwservice))
(allow hal_lineage_trust_default hal_lineage_trust_hwservice (hwservice_manager (add find)))
(allow hal_lineage_trust_client hal_lineage_trust_hwservice (hwservice_manager (find)))
(allow hal_lineage_trust_default hidl_base_hwservice (hwservice_manager (add)))
(type hal_lineage_trust_default)
(roletype object_r hal_lineage_trust_default)
(type hal_lineage_trust_default_exec)
(roletype object_r hal_lineage_trust_default_exec)
(typeattributeset domain (hal_lineage_trust_default))
(typeattributeset halserverdomain (hal_lineage_trust_default))
(typeattributeset hal_lineage_trust_server (hal_lineage_trust_default))
(typeattributeset file_type (hal_lineage_trust_default_exec))
(typeattributeset exec_type (hal_lineage_trust_default_exec))
(typeattributeset vendor_file_type (hal_lineage_trust_default_exec))
(allow init hal_lineage_trust_default_exec (file (read getattr map execute open)))
(allow init hal_lineage_trust_default (process (transition)))
(allow hal_lineage_trust_default hal_lineage_trust_default_exec (file (read getattr map execute entrypoint open)))
(typetransition init hal_lineage_trust_default_exec process hal_lineage_trust_default)
(allow init hal_lineage_trust_default (process (siginh rlimitinh)))

(type hal_lineage_livedisplay_mediatek)
(roletype object_r hal_lineage_livedisplay_mediatek)
(type hal_lineage_livedisplay_mediatek_exec)
(roletype object_r hal_lineage_livedisplay_mediatek_exec)
(typeattributeset domain (hal_lineage_livedisplay_mediatek))
(typeattributeset halserverdomain (hal_lineage_livedisplay_mediatek))
(typeattributeset hal_lineage_livedisplay_server (hal_lineage_livedisplay_mediatek))
(typeattributeset file_type (hal_lineage_livedisplay_mediatek_exec))
(typeattributeset exec_type (hal_lineage_livedisplay_mediatek_exec))
(typeattributeset vendor_file_type (hal_lineage_livedisplay_mediatek_exec))
(allow init hal_lineage_livedisplay_mediatek_exec (file (read getattr map execute open)))
(allow init hal_lineage_livedisplay_mediatek (process (transition)))
(allow hal_lineage_livedisplay_mediatek hal_lineage_livedisplay_mediatek_exec (file (read getattr map execute entrypoint open)))
(typetransition init hal_lineage_livedisplay_mediatek_exec process hal_lineage_livedisplay_mediatek)
(allow init hal_lineage_livedisplay_mediatek (process (siginh rlimitinh)))

; Small leftovers from the first enforcing boot.
(allow ccci_mdinit metadata_file (dir (search)))
(allow fuelgauged_nvram metadata_file (dir (search)))
(allow hal_gatekeeper_default metadata_file (dir (search)))
(allow mtk_hal_audio metadata_file (dir (search)))
(allow mtk_hal_bluetooth metadata_file (dir (search)))
(allow nvram_daemon metadata_file (dir (search)))
(allow rild metadata_file (dir (search)))
(allow ccci_mdinit gsi_metadata_file (dir (search)))
(allow init loop_device (blk_file (ioctl)))
(allow vendor_init debuglog_data_file (dir (search)))
(allow bootanim mnt_user_file (dir (search)))
(allow surfaceflinger mnt_user_file (dir (search)))
(allow mtk_hal_camera shell_data_file (dir (search)))
(allowx init loop_device (ioctl blk_file (range 0x4c00 0x4cff)))
(allow init hal_lineage_trust_default (process (noatsecure)))
(allow init hal_lineage_livedisplay_mediatek (process (noatsecure)))
(allow shell vendor_default_prop (file (read getattr map open)))
(allow shell hal_lineage_trust_default_exec (file (getattr)))
